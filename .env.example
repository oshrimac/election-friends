# Vercel + Neon (or another PostgreSQL provider). Use the pooled URL with TLS.
DATABASE_URL=
# Generate with npm run admin:password (use at least 16 characters).
ADMIN_PASSWORD_HASH=
# Optional canonical origin, e.g. https://election-friends.vercel.app
# Leave unset for Vercel previews; requests are then checked against their own host.
# APP_URL=
# LOCAL_DB_PATH=./.data/ballot
